# ---------------------------------------------------------------------------
# Keep the build context small and make sure no secret ever ends up inside an
# image layer. `COPY . .` in the Dockerfile would otherwise copy the real
# `.env` (DATABASE_URL / JWT_SECRET / ADMIN_DASHBOARD_KEY), the local
# node_modules and the previous build output into the image.
# ---------------------------------------------------------------------------

# Secrets and local configuration
.env
.env.local
.env.*.local

# Dependencies and build output
node_modules
.next
out
build
*.tsbuildinfo

# Version control and CI
.git
.gitignore
.github

# Local database artefacts (the datasource is PostgreSQL)
prisma/*.db
prisma/*.db-journal

# Logs and editor noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem

# Docs / tooling that is not needed at runtime
README.md
Dockerfile
.dockerignore
eslint.config.mjs
