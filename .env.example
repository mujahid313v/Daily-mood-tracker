# ---------------------------------------------------------------------------
# Daily Mood Tracker — environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moodtracker?schema=public"

# Secret used to sign and verify the session JWTs (HS256).
# Generate a strong value with:  openssl rand -base64 48
# Changing this value invalidates every active session.
JWT_SECRET=""

# Key required to unlock the /admin dashboard.
# Generate with:  openssl rand -base64 32
ADMIN_DASHBOARD_KEY=""
